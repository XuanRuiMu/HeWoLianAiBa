# 和我恋爱吧 - Docker 部署根配置模板
#
# 用法：cp .env.example .env 后逐项替换尖括号占位符，再执行 docker compose up -d
#
# 规则：
#   1. 本文件只允许出现占位符与假值，严禁写入任何真实密钥、密码、令牌。
#      gitleaks 会在 CI 里全量历史扫描 .env 一旦入库即阻断（.gitleaks.toml 自定义规则）。
#   2. 标记「必填」的变量在 docker-compose.yml 里用的是 ${VAR:?...} 语法，
#      缺失或为空时 compose 会直接报错退出，不会带着空值启动。
#   3. 后端与前端各自另有独立配置：backend/.env.example、frontend/.env.example。
#      本文件仅服务 docker compose（postgres / redis / backend / frontend / certbot）。

# ─────────────────────────── 数据库 ───────────────────────────
# 必填。库名与账号，建议保持默认以匹配 docker-compose.yml 的默认值。
POSTGRES_DB=lianaiba
POSTGRES_USER=lianaiba
# 必填。请用 openssl rand -base64 24 生成；只含 URL 安全字符时下面的 DATABASE_URL 可直接拼接。
POSTGRES_PASSWORD=<在此填入数据库密码>

# 必填。容器内连接串（主机名是 compose 服务名 postgres，不是 localhost）。
# 注意：密码若含 URL 保留字符（@ : / ? # [ ] % 等），必须做百分号编码，
# 否则 pg 的 WHATWG-URL 解析会把 + 视作空格导致鉴权失败。生成方式见文末说明。
DATABASE_URL=postgresql://lianaiba:REPLACE_ME@postgres:5432/lianaiba

# ─────────────────────────── 缓存 ───────────────────────────
# 必填。Redis 密码，与下面 REDIS_URL 中的密码必须逐字节一致。
REDIS_PASSWORD=REPLACE_ME
# 必填。同样需要百分号编码。
REDIS_URL=redis://:REPLACE_ME@redis:6379

# ─────────────────────────── AI 能力 ───────────────────────────
# 必填。DeepSeek 控制台申请的 API Key。
DEEPSEEK_API_KEY=<在此填入 DeepSeek API Key>
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# ─────────────────────────── 鉴权 ───────────────────────────
# 必填。至少 32 字节随机串；生产环境未达长度时后端启动校验会拒绝启动。
JWT_SECRET=<在此填入至少 32 字节的随机串>
JWT_EXPIRES_IN=7d

# ─────────────────────────── 跨服务调用 ───────────────────────────
# 必填。backend 与其它服务间的内部调用令牌，生产环境后端启动校验要求已设置。
INTERNAL_TOKEN=<在此填入内部调用令牌>

# ─────────────────────────── 访问控制 ───────────────────────────
# 必填。允许携带凭证访问 API 的来源，逗号分隔，需含本机前端开发端口。
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
# 必填。管理员手机号，逗号分隔。切勿保留示例号，否则等于把管理权限开给公开号码。
ADMIN_PHONES=<在此填入管理员手机号>

# ─────────────────────────── 阿里云短信 ───────────────────────────
# 可选。不接短信验证码时两项留空即可，此时验证码登录不可用。
# 若要启用，AK/SK 具备该账号的完整操作权限，属高敏感凭据。
ALIYUN_ACCESS_KEY_ID=
ALIYUN_ACCESS_KEY_SECRET=
# 短信签名与模板代码需在阿里云控制台先行审核通过后填写。
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ─────────────────────────── 日志 ───────────────────────────
# 冷存（logs/cold/）日志保留天数。
LOG_COLD_RETENTION_DAYS=183
# 审计日志保留天数，产品约束 ≥ 180 天。
SHEN_JI_RI_ZHI_BAO_LIU_TIAN=185
# 告警邮件降级开关：true 表示邮件通道故障时降级而非抛错中断。
GAO_JING_SHENG_MING_JIANG_JI=true

# ─────────────────────────── 运维脚本 ───────────────────────────
# deploy/备份数据库.sh 用它定位运行中的 postgres 容器；docker-compose.yml 本身不用。
DOCKER_POSTGRES=lianaiba-postgres

# ─────────────────────────── 密码百分号编码 ───────────────────────────
# 把上文的 REPLACE_ME 全部替换掉再生成编码串：
#   printf '%s' '你的原始密码' | jq -sRr @uri
# 无 jq 时的等价写法（Python）：
#   python -c "import urllib.parse,sys;print(urllib.parse.quote(sys.argv[1],safe=''))" '你的原始密码'
# 把编码结果填回 DATABASE_URL / REDIS_URL 里替换 REPLACE_ME。
# 校验：解码后必须与 POSTGRES_PASSWORD / REDIS_PASSWORD 逐字节一致。
#   python -c "import urllib.parse,sys;print(urllib.parse.unquote(sys.argv[1]))" '<编码后的密码>'
