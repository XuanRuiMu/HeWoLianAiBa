# 和我恋爱吧 - 环境变量模板（仅 dev 假值，禁填真实密钥）
# 真实值只存在于本地 .env（gitignored）或密钥服务，禁止入库、禁止截图外发
POSTGRES_DB=lovewithme
POSTGRES_USER=lovewithme
POSTGRES_PASSWORD=your-postgres-password-at-least-16-chars
DEEPSEEK_API_KEY=your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
JWT_SECRET=your-jwt-secret-at-least-32-bytes-long-string
JWT_EXPIRES_IN=25m
SHUA_XIN_LING_PAI_YOU_XIAO_MIAO=604800
REDIS_PASSWORD=your-redis-password-at-least-16-chars
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret
ALIYUN_SMS_SIGN_NAME=your-sms-sign-name
ALIYUN_SMS_TEMPLATE_CODE=your-sms-template-code
ALLOWED_ORIGINS=http://localhost:5173
ADMIN_PHONES=13800000000
KE_XIN_DAI_LI_WANG_DUAN=172.16.0.0/12
MEI_TI_QIAN_MING_MI_YAO=
BING_DU_SAO_MIAO_QI_YONG=false
BING_DU_SAO_MIAO_FU_WU_URL=
# 敏感值也可用 *_FILE 指向文件（Docker secrets / SOPS 解密输出），优先级高于同名变量
# JWT_SECRET_FILE=/run/secrets/jwt_secret
