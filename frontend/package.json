{
  "name": "hewolianba-frontend",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build --logLevel silent",
    "preview": "vite preview",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:console": "playwright test tests/console-errors.spec.ts",
    "test:upgrade": "npx npm-check-updates -u -f '@playwright/test' && npm i && npx playwright install",
    "generate-icons": "node scripts/generate-pwa-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.62.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/coverage-v8": "^4.1.10",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.11",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-vue": "^10.9.1",
    "globals": "^17.6.0",
    "jsdom": "^29.1.1",
    "npm-check-updates": "^23.1.0",
    "prettier": "^3.8.3",
    "sharp": "^0.35.4",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.2.2",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10",
    "vue-tsc": "^3.3.11"
  },
  "dependencies": {
    "@types/three": "^0.185.0",
    "axios": "^1.16.0",
    "pinia": "^4.0.3",
    "socket.io-client": "^4.8.3",
    "three": "^0.185.0",
    "vue": "^3.5.42",
    "vue-draggable-plus": "^0.6.1",
    "vue-router": "^5.3.0",
    "web-vitals": "^6.0.0"
  }
}
