# ===== 应用基础 =====
# 服务端口
PORT=3000
# 运行环境：development / test / production
NODE_ENV=development
# 日志级别：debug / info / warn / error
LOG_LEVEL=debug

# ===== 数据库与缓存 =====
# PostgreSQL 连接串（含密码，属敏感凭据）
DATABASE_URL=postgresql://your-user:your-password@localhost:5432/your-shuJuKu
# Redis 连接串
REDIS_URL=redis://localhost:6379

# ===== JWT 认证 =====
# JWT 签名密钥（敏感凭据，生产环境务必替换为强随机值）
JWT_SECRET=your-jwt-secret-here
# JWT 过期时间
JWT_EXPIRES_IN=7d

# ===== 管理员 =====
# 管理员手机号列表（逗号分隔）
ADMIN_PHONES=

# ===== 阿里云短信服务 =====
# 阿里云 AccessKey ID（敏感凭据）
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id-here
# 阿里云 AccessKey Secret（敏感凭据）
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret-here
# 短信签名名称
ALIYUN_SMS_SIGN_NAME=your-sms-sign-name-here
# 短信模板代码
ALIYUN_SMS_TEMPLATE_CODE=your-sms-template-code-here

# ===== AI 服务（DeepSeek）=====
# DeepSeek API 密钥（敏感凭据）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DeepSeek API 基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 模型名称：必须是官方 /v1/models 在册名（当前 deepseek-flash / deepseek-v4-pro）。
# 不要用内测临时通道名（形如 …-expires-on-…）：它不在册、随时下线，且拿不到正式的上下文硬盘缓存，
# 会把 Prompt构建器::gouJianGongXiangQianZhui 的整套前缀复用优化清零（该用例已把这条钉成测试）。
DEEPSEEK_MODEL=deepseek-flash

# ===== 多模态C混合省钱（FP-10）=====
# 语音理解总开关（免费本地ASR始终可用，本开关控制是否经硅基流动音频理解 enrich 后再进 DeepSeek）
YU_YIN_LI_JIE_QI_YONG=false
# 硅基流动基础地址
GUI_JI_LIU_DONG_JI_CHU_URL=https://api.siliconflow.cn/v1
# 硅基流动 API 密钥（敏感凭据，日志脱敏）
GUI_JI_LIU_DONG_API_MI_YAO=
# 硅基流动音频理解模型（空=未配置，服务降级为本地转写直入 DeepSeek）
GUI_JI_LIU_DONG_YU_YIN_MO_XING=
# 视频理解总开关（画面+声音文本化后进 DeepSeek，默认关闭省钱）
SHI_PIN_LI_JIE_QI_YONG=false
# 按次计费生图总开关与供应商配置（空密钥=未开启，前端隐藏入口，后端降级提示）
TU_XIANG_SHENG_CHENG_QI_YONG=false
TU_XIANG_SHENG_CHENG_JI_CHU_URL=https://api.siliconflow.cn/v1
TU_XIANG_SHENG_CHENG_API_MI_YAO=
TU_XIANG_SHENG_CHENG_MO_XING=
# 按次计费生成视频总开关与供应商配置
SHI_PIN_SHENG_CHENG_QI_YONG=false
SHI_PIN_SHENG_CHENG_JI_CHU_URL=https://api.siliconflow.cn/v1
SHI_PIN_SHENG_CHENG_API_MI_YAO=

# 视频理解（抽帧 + 抽音轨转写）。生产镜像已内置 ffmpeg，这两项通常留空即可。
# ⚠️ ffmpeg 缺失不会报错，只会让所有视频退化成「[视频：文件名]」占位（角色看不见画面），
#    服务启动时会在「启动校验」里打一条 WARN。看到那条日志先查这两项。
# 留空 = 自动探测 /usr/bin/ffmpeg 等常见路径；非标准位置才需要显式指定绝对路径。
SHI_PIN_JIE_XI_FFMPEG_LU_JING=
# 均匀抽帧数量（1~6，越多画面描述越完整，视觉调用次数也越多）。默认 4。
SHI_PIN_JIE_XI_ZHEN_SHU=4
SHI_PIN_SHENG_CHENG_MO_XING=
# 每用户每日生成上限（生图+生成视频分别计数，超限 429 优雅提示）
MEI_RI_SHENG_CHENG_SHANG_XIAN=10
# 多模态供应商请求超时毫秒
DUO_MO_TAI_QING_QIU_CHAO_SHI_HAO_MIAO=8000
# 生图/生成视频提示词最大字符
SHENG_TU_TI_SHI_CI_ZUI_DA_ZI_FU=200
SHI_PIN_TI_SHI_CI_ZUI_DA_ZI_FU=200

# ===== OpenTelemetry 全链路追踪 =====
# OTel OTLP HTTP exporter 端点（默认 http://localhost:4318/v1/traces）
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces

# ===== 安全过滤 =====
# 敏感关键词列表（逗号分隔），用于日志脱敏关键词匹配
MIN_GAN_GUAN_JIAN_ZI=password,miMa,mi_ma,yanZhengMa,yan_zheng_ma,token,lingPai,ling_pai,jwt,miYao,mi_yao,apiKey,api_key,apiMiYao,api_mi_yao
# 敏感字段名列表（逗号分隔），用于日志脱敏字段匹配
MIN_GAN_ZI_DUAN_MING=password,miMa,mi_ma,yanZhengMa,yan_zheng_ma,token,lingPai,ling_pai,jwt,miYao,mi_yao,apiKey,api_key,apiMiYao,api_mi_yao,fangWenMiYao,fang_wen_mi_yao,fangWenMiYaoMiMa,fang_wen_mi_yao_mi_ma,ALIYUN_ACCESS_KEY_SECRET,DEEPSEEK_API_KEY,JWT_SECRET,GUI_JI_LIU_DONG_API_MI_YAO,TU_XIANG_SHENG_CHENG_API_MI_YAO,SHI_PIN_SHENG_CHENG_API_MI_YAO

# ===== 跨域 =====
# 允许的来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173

# ===== TTS 语音合成（MiniMax）=====
# TTS 服务开关
TTS_ENABLED=true
# TTS 微服务地址（FastAPI 服务）
TTS_SERVICE_URL=http://localhost:8001
# 内部服务间通信令牌（需与 tts-service 一致）
INTERNAL_TOKEN=your-internal-token-here

# ===== 开场多样化（机制 D，PROGRESS-模拟真人聊天.md §10.1）=====
# 总开关。关闭（缺省）时 Writer 不注入任何开场约束，行为与改动前完全一致。
# 开启后每轮把「真人高频开场短句」抽若干条给模型挑，治 AI 开场 token 复用率偏高（基线 73.65%）。
# ⚠️ 该机制在 120 轮量级尚未验收，灰度期建议先小范围开启。
KAI_CHANG_QIAN_ZHI_QI_YONG=false
# 每轮给模型的候选条数（2–12）
KAI_CHANG_HOU_XUAN_GE_SHU=5
# 采样表条数上限（1–200，表本体 200 条）
KAI_CHANG_BIAO_TIAO_SHU=200
# 开发模式：把每轮注入的候选打进日志，便于核对
KAI_CHANG_KAI_FA_MO_SHI=false

# ===== 秘籍口令 =====
# 聊天中发送该口令可一键满好感（测试/演示用）。留空 = 秘籍功能整体关闭。
# 属敏感凭据：只在此处或部署环境注入，禁止写进代码、文档、日志。
MI_JI_KOU_LING=
MEI_TI_SHEN_HE_MO_SHI=ai
