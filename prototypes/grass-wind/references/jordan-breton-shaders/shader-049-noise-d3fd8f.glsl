precision highp float;uniform float uTime;uniform vec2 uResolution;uniform float uIntensity;uniform float uOpacity;uniform mat4 uCameraMatrix;uniform sampler2D uDepthTexture;uniform float uCameraNear;uniform float uCameraFar;uniform float uSteps;uniform float uAltitude;uniform float uFovScale;uniform float uFrameJitter;uniform sampler2D uNoiseTexture;varying vec2 vUv;float linearizeDepth(float depth){return uCameraNear*uCameraFar/(uCameraFar-depth*(uCameraFar-uCameraNear));}
#define PI 3.14159265359
float sampleAuroraNoise(vec2 p){vec2 noiseUV=p/20.0+0.5;vec4 noise=texture2D(uNoiseTexture,noiseUV);float shortStep=1.667;float longStep=5.0;float totalCycle=shortStep*3.0+longStep;float t=mod(uTime,totalCycle);float n0,n1,blend;if(t<shortStep){n0=noise.r;n1=noise.g;blend=t/shortStep;}else if(t<shortStep*2.0){n0=noise.g;n1=noise.b;blend=(t-shortStep)/shortStep;}else if(t<shortStep*3.0){n0=noise.b;n1=noise.a;blend=(t-shortStep*2.0)/shortStep;}else{n0=noise.a;n1=noise.r;blend=(t-shortStep*3.0)/longStep;}return mix(n0,n1,blend);}float hash21(in vec2 n){return fract(sin(dot(n,vec2(12.9898,4.1414)))*43758.5453);}vec4 aurora(vec3 ro,vec3 rd){vec4 col=vec4(0.0);vec4 avgCol=vec4(0.0);float maxSteps=50.0;float stepSize=maxSteps/uSteps;for(float i=0.0;i<50.0;i++){if(i>=uSteps)break;float baseIdx=i*stepSize;float jitter=hash21(gl_FragCoord.xy+vec2(i*13.37,0.0))*stepSize;float idx=baseIdx+mod(jitter+uFrameJitter*stepSize,stepSize);float of=0.006*hash21(gl_FragCoord.xy)*smoothstep(0.0,15.0,idx);float pt=((uAltitude+pow(idx,1.4)*0.002)-ro.y)/(rd.y*2.0+0.4);pt-=of;vec3 bpos=ro+pt*rd;vec2 p=bpos.zx;float rzt=sampleAuroraNoise(p);vec4 col2=vec4(0.0,0.0,0.0,rzt);col2.rgb=(sin(1.0-vec3(2.15,-0.5,1.2)+idx*0.043)*0.5+0.5)*rzt;avgCol=mix(avgCol,col2,0.5);col+=avgCol*exp2(-idx*0.065-2.5)*smoothstep(0.0,5.0,idx)*stepSize;}col*=clamp(rd.y*15.0+0.4,0.0,1.0);return col*1.8;}void main(){float aspectRatio=uResolution.x/uResolution.y;vec2 p=vUv-0.5;p.x*=aspectRatio;p*=uFovScale*2.0;vec3 rdView=normalize(vec3(p,-1.0));vec3 rd=normalize((uCameraMatrix*vec4(rdView,0.0)).xyz);float horizonFade=smoothstep(0.0,0.15,rd.y);if(horizonFade<=0.0){gl_FragColor=vec4(0.0);return;}vec3 ro=vec3(0.0,0.0,0.0);vec4 aur=aurora(ro,rd);gl_FragColor=vec4(aur.rgb*uIntensity,aur.a*uOpacity*horizonFade);}