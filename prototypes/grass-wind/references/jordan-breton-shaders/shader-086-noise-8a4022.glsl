vec3 fireHash33(vec3 p){uvec3 q=uvec3(ivec3(p))*UI3;q=(q.x ^ q.y ^ q.z)*UI3;return-1.0+2.0*vec3(q)*UIF;}vec3 fireHash33Positive(vec3 p){return fireHash33(p)*0.5+0.5;}float fireGradientNoise(vec3 x,float period){vec3 p=floor(x);vec3 w=fract(x);vec3 u=w*w*w*(w*(w*6.0-15.0)+10.0);vec3 ga=fireHash33(mod(p+vec3(0.0,0.0,0.0),period));vec3 gb=fireHash33(mod(p+vec3(1.0,0.0,0.0),period));vec3 gc=fireHash33(mod(p+vec3(0.0,1.0,0.0),period));vec3 gd=fireHash33(mod(p+vec3(1.0,1.0,0.0),period));vec3 ge=fireHash33(mod(p+vec3(0.0,0.0,1.0),period));vec3 gf=fireHash33(mod(p+vec3(1.0,0.0,1.0),period));vec3 gg=fireHash33(mod(p+vec3(0.0,1.0,1.0),period));vec3 gh=fireHash33(mod(p+vec3(1.0,1.0,1.0),period));float va=dot(ga,w-vec3(0.0,0.0,0.0));float vb=dot(gb,w-vec3(1.0,0.0,0.0));float vc=dot(gc,w-vec3(0.0,1.0,0.0));float vd=dot(gd,w-vec3(1.0,1.0,0.0));float ve=dot(ge,w-vec3(0.0,0.0,1.0));float vf=dot(gf,w-vec3(1.0,0.0,1.0));float vg=dot(gg,w-vec3(0.0,1.0,1.0));float vh=dot(gh,w-vec3(1.0,1.0,1.0));return va+u.x*(vb-va)+u.y*(vc-va)+u.z*(ve-va)+u.x*u.y*(va-vb-vc+vd)+u.y*u.z*(va-vc-ve+vg)+u.z*u.x*(va-vb-ve+vf)+u.x*u.y*u.z*(-va+vb+vc-vd+ve-vf-vg+vh);}/***Tileable BubblesNoise for fire*@param uv-UV coordinates(already scaled by caller)*@param period-Tiling period*/float fireBubblesNoise(vec2 uv,float period){vec3 position=vec3(uv.x,uv.y,0.0);float noise=fireGradientNoise(position,period);return noise*0.5+0.5;}vec2 fireHash22(vec2 p){uvec2 q=uvec2(ivec2(p))*uvec2(UI0,UI1);q=(q.x ^ q.y)*uvec2(UI0,UI1);return vec2(q)*UIF;}/***Tileable 2D Voronoi noise*@param coord-2D coordinate(already scaled)*@param period-Tiling period*/float fireVoronoi2D(vec2 coord,float period){vec2 cellPosition=floor(coord);vec2 localPosition=fract(coord);float minDistance=1e10;for(int j=-1;j<=1;j++){for(int i=-1;i<=1;i++){vec2 cellOffset=vec2(float(i),float(j));vec2 neighborCell=cellPosition+cellOffset;vec2 wrappedCell=mod(neighborCell,period);vec2 randomOffset=fireHash22(wrappedCell);vec2 pointPosition=cellOffset+randomOffset;float dist=distance(pointPosition,localPosition);minDistance=min(minDistance,dist);}}return minDistance;}/***Tileable 2D Smooth Voronoi*@param coord-2D coordinate(already scaled)*@param period-Tiling period*/float fireSmoothVoronoi2D(vec2 coord,float period){vec2 cellPosition=floor(coord);vec2 localPosition=fract(coord);float smoothDistance=0.0;float h=-1.0;float smoothness=1.0;for(int j=-2;j<=2;j++){for(int i=-2;i<=2;i++){vec2 cellOffset=vec2(float(i),float(j));vec2 neighborCell=cellPosition+cellOffset;vec2 wrappedCell=mod(neighborCell,period);vec2 randomOffset=fireHash22(wrappedCell);vec2 pointPosition=cellOffset+randomOffset;float dist=distance(pointPosition,localPosition);float mask=float(h==-1.0);h=mix(smoothstep(0.0,1.0,0.5+0.5*(smoothDistance-dist)/smoothness),1.0,mask);float correctionFactor=smoothness*h*(1.0-h);smoothDistance=mix(smoothDistance,dist,h)-correctionFactor;}}return smoothDistance;}/***Tileable Voronoi noise for fire*@param coord-3D coordinate(already scaled by caller)*@param period-Tiling period for X and Y(Z is not tiled)*/float fireVoronoi(vec3 coord,float period){vec3 cellPosition=floor(coord);vec3 localPosition=fract(coord);float minDistance=1e10;for(int k=-1;k<=1;k++){for(int j=-1;j<=1;j++){for(int i=-1;i<=1;i++){vec3 cellOffset=vec3(float(i),float(j),float(k));vec3 neighborCell=cellPosition+cellOffset;vec3 wrappedCell=vec3(mod(neighborCell.x,period),mod(neighborCell.y,period),neighborCell.z);vec3 randomOffset=fireHash33Positive(wrappedCell);vec3 pointPosition=cellOffset+randomOffset;float dist=distance(pointPosition,localPosition);minDistance=min(minDistance,dist);}}}return minDistance;}/***Tileable Smooth Voronoi for fire*@param coord-3D coordinate(already scaled by caller)*@param period-Tiling period for X and Y*/float fireSmoothVoronoi(vec3 coord,float period){vec3 cellPosition=floor(coord);vec3 localPosition=fract(coord);float smoothDistance=0.0;float h=-1.0;float smoothness=1.0;for(int k=-2;k<=2;k++){for(int j=-2;j<=2;j++){for(int i=-2;i<=2;i++){vec3 cellOffset=vec3(float(i),float(j),float(k));vec3 neighborCell=cellPosition+cellOffset;vec3 wrappedCell=vec3(mod(neighborCell.x,period),mod(neighborCell.y,period),neighborCell.z);vec3 randomOffset=fireHash33Positive(wrappedCell);vec3 pointPosition=cellOffset+randomOffset;float dist=distance(pointPosition,localPosition);float mask=float(h==-1.0);h=mix(smoothstep(0.0,1.0,0.5+0.5*(smoothDistance-dist)/smoothness),1.0,mask);float correctionFactor=smoothness*h*(1.0-h);smoothDistance=mix(smoothDistance,dist,h)-correctionFactor;}}}return smoothDistance;}varying vec2 vUv;void main(){float detailScale=4.0;vec2 scaledUv=vUv*detailScale;float noise=0.0;noise+=fireBubblesNoise(scaledUv,detailScale)*0.5;noise+=fireBubblesNoise(scaledUv*2.0,detailScale*2.0)*0.25;noise+=fireBubblesNoise(scaledUv*4.0,detailScale*4.0)*0.125;noise+=fireBubblesNoise(scaledUv*8.0,detailScale*8.0)*0.125;float foamVoronoi=fireVoronoi2D(scaledUv,detailScale);float smoothFoamVoronoi=fireSmoothVoronoi2D(vUv*8.0,8.0);gl_FragColor=vec4(noise,foamVoronoi,smoothFoamVoronoi,1.0);}