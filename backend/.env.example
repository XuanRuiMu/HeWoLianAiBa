# ===== 应用基础 =====
# 服务端口
PORT=3000
# 运行环境：development / test / production
NODE_ENV=development
# 日志级别：debug / info / warn / error
LOG_LEVEL=debug

# ===== 数据库与缓存 =====
# PostgreSQL 连接串（含密码，属敏感凭据）
DATABASE_URL=postgresql://your-user:your-password@localhost:5432/your-database
# Redis 连接串
REDIS_URL=redis://localhost:6379

# ===== JWT 认证 =====
# JWT 签名密钥（敏感凭据，生产环境务必替换为强随机值）
JWT_SECRET=your-jwt-secret-here
# JWT 过期时间
JWT_EXPIRES_IN=7d

# ===== 管理员 =====
# 管理员手机号列表（逗号分隔）
ADMIN_PHONES=

# ===== 阿里云短信服务 =====
# 阿里云 AccessKey ID（敏感凭据）
ALIYUN_ACCESS_KEY_ID=your-aliyun-access-key-id-here
# 阿里云 AccessKey Secret（敏感凭据）
ALIYUN_ACCESS_KEY_SECRET=your-aliyun-access-key-secret-here
# 短信签名名称
ALIYUN_SMS_SIGN_NAME=your-sms-sign-name-here
# 短信模板代码
ALIYUN_SMS_TEMPLATE_CODE=your-sms-template-code-here

# ===== AI 服务（DeepSeek）=====
# DeepSeek API 密钥（敏感凭据）
DEEPSEEK_API_KEY=your-deepseek-api-key-here
# DeepSeek API 基础地址
DEEPSEEK_BASE_URL=https://api.deepseek.com
# DeepSeek 模型名称
DEEPSEEK_MODEL=deepseek-v4-pro

# ===== 安全过滤 =====
# 敏感关键词列表（逗号分隔），用于日志脱敏关键词匹配
MIN_GAN_GUAN_JIAN_ZI=password,miMa,mi_ma,yanZhengMa,yan_zheng_ma,token,lingPai,ling_pai,jwt,miYao,mi_yao,apiKey,api_key,apiMiYao,api_mi_yao
# 敏感字段名列表（逗号分隔），用于日志脱敏字段匹配
MIN_GAN_ZI_DUAN_MING=password,miMa,mi_ma,yanZhengMa,yan_zheng_ma,token,lingPai,ling_pai,jwt,miYao,mi_yao,apiKey,api_key,apiMiYao,api_mi_yao,fangWenMiYao,fang_wen_mi_yao,fangWenMiYaoMiMa,fang_wen_mi_yao_mi_ma,ALIYUN_ACCESS_KEY_SECRET,DEEPSEEK_API_KEY,JWT_SECRET

# ===== 跨域 =====
# 允许的来源（逗号分隔）
ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:5173,http://127.0.0.1:5173
